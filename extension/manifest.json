{
  "manifest_version": 3,
  "name": "Baiak Loot Planner",
  "version": "0.2.1",
  "description": "Drops, Codex e charms ao vivo no Baiak Idle. Ferramenta de fã, sem vínculo oficial. Dados de uso anônimos, que dá para desligar.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://baiakidle.com/jogar/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://baiakidle.com/jogar/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/items/*.png"
      ],
      "matches": [
        "https://baiakidle.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Baiak Loot Planner"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
