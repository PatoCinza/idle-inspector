{
  "manifest_version": 3,
  "name": "Baiak Loot Planner",
  "version": "0.4.2",
  "description": "Drops, Codex, charms, XP e hunts ao vivo no Baiak Idle. Ferramenta de fã, sem vínculo oficial. Telemetria anônima só se você ligar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://baiakidle.com/jogar/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://baiakidle.com/jogar/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/items/*.png",
        "icons/icon-32.png"
      ],
      "matches": [
        "https://baiakidle.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Baiak Loot Planner",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
