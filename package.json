{
  "name": "baiak-loot-planner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "extract": "node scripts/extract.js",
    "build": "node scripts/build.js",
    "images": "node scripts/fetch-images.js",
    "compare": "node scripts/compare.js",
    "build:ext": "node scripts/build-extension.js",
    "package:ext": "node scripts/package-extension.js",
    "build:web": "npm run build && npm run package:ext && node scripts/build-web.js",
    "deploy:web": "npm run build:web && npx wrangler pages deploy dist/web --project-name baiak-loot --branch main"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.13"
  }
}
